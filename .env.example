LEGENDARR_DATA_DIR=./data
# Optional: key used to encrypt secrets at rest. Leave empty to auto-generate
# <data_dir>/.secret_key on first run.
LEGENDARR_SECRET_KEY=
LEGENDARR_RADARR_URL=http://localhost:7878
LEGENDARR_RADARR_API_KEY=
LEGENDARR_SONARR_URL=http://localhost:8989
LEGENDARR_SONARR_API_KEY=
# Optional: externally-reachable address of this legendarr instance, used to build the
# Radarr/Sonarr webhook URL shown on the Arr Services page. Also editable from the web UI.
LEGENDARR_PUBLIC_URL=
LEGENDARR_SYNC_INTERVAL_MINUTES=15
LEGENDARR_BACKEND_API_URL=http://127.0.0.1:8000/api
# Optional: require login for the web UI and the backend API. Off by default. Once
# enabled, set the admin username/password and view/regenerate the API key from
# Settings → Authentication rather than env vars.
LEGENDARR_AUTH_ENABLED=false
